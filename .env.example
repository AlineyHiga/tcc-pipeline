# Required
OPENAI_API_KEY=sk-...
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=your-token
SONAR_PROJECT_KEY=sample-project

# Optional
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=owner/repo
MAX_ROUNDS=3
ISSUE_SEVERITIES=MAJOR,CRITICAL
BASE_BRANCH=main
AUTO_BRANCH_PREFIX=autofix

# LLM configuration
LLM_PROVIDER=openai  # ou local
LLM_LOCAL_MODEL_PATH=/path/para/modelo.gguf
LLM_LOCAL_CHAT_FORMAT=llama-2
LLM_LOCAL_CTX=4096
LLM_LOCAL_THREADS=0
