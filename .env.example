# Required SonarQube configuration
SONARQUBE_URL=http://localhost:9100
SONARQUBE_TOKEN=your_sonar_token_here
SONAR_PROJECT_KEY=your_project_key
SONAR_PROJECT_NAME=your_project_name
SONAR_SOURCES=src

# Target repository
AUTOFIX_TARGET_ROOT=/absolute/path/to/target/repo

# LLM Configuration (OpenAI API compatible)
OPENAI_BASE_URL=http://localhost:11435/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=deepseek-coder:1.5b
LLM_PROVIDER=openai
LLM_MAX_COMPLETION_TOKENS=8192

# Local LLM Configuration (alternative to OpenAI API)
LLM_LOCAL_MODEL_PATH=/path/to/model.gguf
LLM_LOCAL_CTX=4096
LLM_LOCAL_THREADS=0
LLM_LOCAL_CHAT_FORMAT=llama-2
LLM_LOCAL_MAX_TOKENS=9192

# Pipeline Configuration
MAX_ROUNDS=20
ISSUE_SEVERITIES=MAJOR,CRITICAL
LANGGRAPH_RECURSION_LIMIT=10

# Test Isolation Configuration
TEST_ISOLATION_MODE=docker
TEST_ISO_IMAGE=python:3.11-slim
TEST_TIMEOUT_SECS=300
COV_TARGET=src

# GitHub Integration (optional)
GITHUB_TOKEN=your_github_token
GITHUB_REPOSITORY=owner/repo-name
BASE_BRANCH=main
AUTO_BRANCH_PREFIX=fix/sonar
PR_AUTO_MERGE=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=1
LOG_REDACT=1
LOG_SAMPLE_LLM=3